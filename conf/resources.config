/*
 * Resource and environment labels.
 *
 * Every process gets a resource label (cpu_small, cpu_medium, etc.) and
 * an environment label (env_cite_seq, env_milo). Resource labels set
 * cpus/memory/time. Environment labels set the conda path.
 */

process {
    // ── Resource tiers ──────────────────────────────────────────────
    withLabel: cpu_small {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }
    withLabel: cpu_medium {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }
    withLabel: cpu_large {
        cpus   = 8
        memory = '32 GB'
        time   = '4h'
    }
    // GPU labels (gpu_totalvi, gpu_scvi) are defined in sge.config
    // to co-locate resources with queue/GPU directives.

    // ── Software environments ───────────────────────────────────────
    // conda_env is a required param (nextflow.config). Pass via
    // --conda_env at invocation.
    withLabel: env_cite_seq {
        conda = "${params.conda_env}"
    }
}
