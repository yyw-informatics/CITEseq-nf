/*
 * SGE executor configuration.
 *
 * GPU queue strings are required at invocation when running GPU steps
 * (steps 06 totalVI, 07 scVI). Pass via:
 *   --sge_gpu_totalvi_queue 'gpu.q@<host>'
 *   --sge_gpu_scvi_queue    'gpu.q@<host>'
 *
 * Forks for non-SGE clusters should swap this whole file for a
 * slurm.config / awsbatch.config etc. and adjust profiles in nextflow.config.
 */

process {
    clusterOptions = { "-l h_vmem=${task.memory.toGiga()}G -m n" }
    penv           = 'smp'

    withLabel: gpu_totalvi {
        cpus   = 4
        memory = '64 GB'
        time   = '4h'
        clusterOptions = { "-l h_vmem=${task.memory.toGiga()}G -q ${params.sge_gpu_totalvi_queue} -l gpu=1 -m n" }
    }
    withLabel: gpu_scvi {
        cpus   = 8
        memory = '12 GB'
        time   = '4h'
        clusterOptions = { "-l h_vmem=${task.memory.toGiga()}G -q ${params.sge_gpu_scvi_queue} -l gpu=1 -m n" }
    }
}

executor {
    name      = 'sge'
    queueSize = 20
}
