/*
 * citeseq-nf — generic CITE-seq preprocessing + embedding pipeline
 *
 * Design rule: params are OVERRIDE-ONLY. Defaults live in
 * scripts/config.py and scripts/config.R. Params here default to null
 * except where a non-null default is safe for a study-neutral pipeline.
 *
 * REQUIRED at invocation:
 *   --project_root <dir>   Caller study's project root. Exported to every
 *                          process as CITESEQ_PROJECT_ROOT; citeseq-nf's
 *                          config.py reads this to resolve output paths.
 *   --outdir       <dir>   Where outputs (data/processed, results, logs,
 *                          figures, models) land. Usually = project_root.
 *   --conda_env    <path>  CITE-seq conda/mamba env. python/rscript
 *                          default to ${conda_env}/bin/{python,Rscript}.
 *   --panel        <path>  ADT panel YAML defining your antibody panel.
 *                          See panels/example_panel.yaml for the schema.
 *   --data_root    <dir>   CellRanger input root. One subdirectory per
 *                          library, each holding that library's raw and
 *                          filtered feature-barcode h5 files. Exported as
 *                          CITESEQ_DATA_ROOT; no default.
 *
 * OPTIONAL but typical for a real run:
 *   --sample_metadata_json <path>  JSON dict: library_id -> {donor,age,...}
 *   --forced_hvgs_file     <path>  Text file, one gene per line (# comments OK)
 *   --branch               decontx|soupx  Decontamination branch
 *   --qc_mad_n_mads        <int>  QC stringency override
 */

// ── Params (override-only) ──────────────────────────────────────────
params {
    // REQUIRED — no defaults. main.nf errors early if missing.
    // conda_env: path to the CITE-seq conda/mamba env. python and rscript
    // default to ${conda_env}/bin/{python,Rscript} when not explicitly set.
    conda_env    = null
    python       = null
    rscript      = null

    project_root = null
    outdir       = null
    // data_root: CellRanger input root, one subdirectory per library.
    data_root    = null

    // Study-configurable (no defaults; citeseq-nf is study-neutral)
    sample_metadata_json = null
    forced_hvgs_file     = null
    panel                = null
    biological_separation_marker = null
    n_libraries          = null   // overrides the count derived from sample_metadata_json

    // Input files — required for entry points that use them
    adata_qc      = null
    adata_adt_raw = null
    adata_qc_clr  = null   // for -entry from_clr checkpoint
    adata_qc_hvg  = null   // for -entry from_hvg checkpoint (steps 06+07+08)
    adata_totalvi = null   // for -entry from_totalvi_scvi checkpoint (step08 only)
    adata_scvi    = null   // for -entry from_totalvi_scvi checkpoint (step08 only)
    adt_counts_for_thresholdr = null  // for -entry from_qc checkpoint

    // Decontamination branch selection
    branch = null
    run_both_branches = false

    // Sweepable parameter overrides
    qc_mad_n_mads = null

    // SGE GPU queue strings — required when running GPU steps under -profile sge.
    // Format: 'gpu.q@<host>' or whatever the cluster's GPU queue spec is.
    sge_gpu_totalvi_queue = null
    sge_gpu_scvi_queue    = null
}

// ── Derive python/rscript from conda_env if not explicitly set ──────
if (params.conda_env && !params.python)  { params.python  = "${params.conda_env}/bin/python"  }
if (params.conda_env && !params.rscript) { params.rscript = "${params.conda_env}/bin/Rscript" }

// ── Work directory ──────────────────────────────────────────────────
// Override via -w <dir> on the nextflow CLI or by setting NXF_WORK.
// Defaults to ./work (project-relative) per Nextflow conventions.

// ── Process defaults ────────────────────────────────────────────────
// beforeScript exports CITESEQ_* env vars that citeseq-nf's config.py /
// config.R read. Only non-null params are exported (keeps config-side
// defaults active when caller omits a param).
process {
    beforeScript = { [
        "export MALLOC_ARENA_MAX=2",
        "export MALLOC_TRIM_THRESHOLD_=0",
        "export OMP_NUM_THREADS=\${NSLOTS:-${task.cpus}}",
        "export MKL_NUM_THREADS=\${NSLOTS:-${task.cpus}}",
        "ENV_LIB=${params.conda_env}/lib",
        "export LD_LIBRARY_PATH=\${ENV_LIB}:\${LD_LIBRARY_PATH:-}",
        "export CITESEQ_PROJECT_ROOT=${params.project_root}",
        "export CITESEQ_PYTHON_BIN=${params.python}",
        params.outdir               ? "export CITESEQ_PROCESSED_DIR=${params.outdir}/data/processed" : null,
        params.outdir               ? "export CITESEQ_MODELS_DIR=${params.outdir}/models"            : null,
        params.outdir               ? "export CITESEQ_RESULTS_DIR=${params.outdir}/results"          : null,
        params.outdir               ? "export CITESEQ_FIGURES_DIR=${params.outdir}/figures"          : null,
        params.data_root            ? "export CITESEQ_DATA_ROOT=${params.data_root}"                 : null,
        params.sample_metadata_json ? "export CITESEQ_SAMPLE_METADATA_JSON=${params.sample_metadata_json}" : null,
        params.forced_hvgs_file     ? "export CITESEQ_FORCED_HVGS_FILE=${params.forced_hvgs_file}"       : null,
        params.panel                ? "export CITESEQ_PANEL_YAML=${params.panel}"                        : null,
        params.qc_mad_n_mads != null ? "export CITESEQ_QC_MAD_N_MADS=${params.qc_mad_n_mads}"            : null,
        params.n_libraries   != null ? "export CITESEQ_N_LIBRARIES=${params.n_libraries}"               : null,
    ].findAll { it != null }.join("\n") }
}

// ── Resource and environment labels ─────────────────────────────────
includeConfig 'conf/resources.config'

// ── Profiles ────────────────────────────────────────────────────────
profiles {
    local {
        process.executor = 'local'
    }
    sge {
        process.executor = 'sge'
        includeConfig 'conf/sge.config'
    }
}

// ── Timeline / report ───────────────────────────────────────────────
timeline {
    enabled = true
    file    = params.outdir ? "${params.outdir}/logs/nextflow/timeline.html" : "logs/nextflow/timeline.html"
}
report {
    enabled = true
    file    = params.outdir ? "${params.outdir}/logs/nextflow/report.html" : "logs/nextflow/report.html"
}
